{
  "name": "colossus",
  "private": true,
  "version": "1.0.0",
  "description": "COLOSSUS - a third-person boss fight against a stone golem in a ruined arena (Vite + TypeScript + Three.js, Blender-made assets, synthesized audio)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "playtest": "node scripts/playtest.mjs",
    "balance": "node scripts/playtest.mjs --scenario bot",
    "assets": "node scripts/build-assets.mjs",
    "film": "node scripts/film.mjs",
    "media": "node scripts/make-media.mjs",
    "site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
